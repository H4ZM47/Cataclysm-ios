 namespace
 {
+#if defined(CATA_IOS)
+// The game data is inside the read-only app bundle, so the parsed-JSON
+// caches for it go to the app's Caches directory instead.
+std::filesystem::path bundle_cache_path( const char *name )
+{
+    return std::filesystem::u8path( cata_ios::cache_dir() + name );
+}
+#endif
+
 flexbuffer_cache &base_cache()
 {
+#if defined(CATA_IOS)
+    static flexbuffer_cache cache{ bundle_cache_path( "base" ), PATH_INFO::base_path().get_unrelative_path() };
+#else
     static flexbuffer_cache cache{ ( PATH_INFO::base_path() / "cache" ).get_unrelative_path(), PATH_INFO::base_path().get_unrelative_path() };
+#endif
     return cache;
 }
 
@@ -25,7 +42,11 @@ flexbuffer_cache &config_cache()
 
 flexbuffer_cache &data_cache()
 {
+#if defined(CATA_IOS)
+    static flexbuffer_cache cache{ bundle_cache_path( "data" ), PATH_INFO::datadir_path().get_unrelative_path() };
+#else
     static flexbuffer_cache cache{ ( PATH_INFO::datadir_path() / "cache" ).get_unrelative_path(), PATH_INFO::datadir_path().get_unrelative_path() };
+#endif
     return cache;
 }
 
