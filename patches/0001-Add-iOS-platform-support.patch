+static bool ios_handle_resize()
+{
+    const int old_width = TERMINAL_WIDTH;
+    const int old_height = TERMINAL_HEIGHT;
+    ios_update_window_metrics();
+    ios_fit_terminal_to_safe_area();
+    if( old_width == TERMINAL_WIDTH && old_height == TERMINAL_HEIGHT ) {
+        return false;
+    }
+    need_invalidate_framebuffers = true;
+    catacurses::stdscr = catacurses::newwin( TERMINAL_HEIGHT, TERMINAL_WIDTH, point::zero );
+    throwErrorIf( !SetupRenderTarget(), "SetupRenderTarget failed" );
+    game_ui::init_ui();
+    ui_manager::screen_resized();
+    return true;
+}
