+// Convert a pointer position in window points (iPad trackpad or mouse) into
+// pixels on the terminal buffer, which is what the game expects.
+static point ios_window_to_terminal( const point &p )
+{
+    int width_points = 0;
+    int height_points = 0;
+    SDL_GetWindowSize( ::window.get(), &width_points, &height_points );
+    if( width_points <= 0 || height_points <= 0 ) {
+        return p;
+    }
+    const int buffer_width = TERMINAL_WIDTH * fontwidth;
+    const int buffer_height = TERMINAL_HEIGHT * fontheight;
+    const SDL_Rect dst = get_android_render_rect( buffer_width, buffer_height );
+    const float x = p.x * static_cast<float>( WindowWidth ) / width_points;
+    const float y = p.y * static_cast<float>( WindowHeight ) / height_points;
+    return point( static_cast<int>( ( x - dst.x ) * buffer_width / std::max( dst.w, 1 ) ),
+                  static_cast<int>( ( y - dst.y ) * buffer_height / std::max( dst.h, 1 ) ) );
+}
